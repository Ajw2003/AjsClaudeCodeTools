+def changed_lines(text):
+    """{file: ([added], [removed])} from a unified diff. Spacing is collapsed and blank lines are left out,
+    so reformatting and shifted line numbers never count as a change."""
+    out, cur = {}, None
+    for line in text.splitlines():
+        if line.startswith("diff --git "):
+            cur = out.setdefault(line.split(" b/", 1)[-1], ([], []))
+        elif cur is None or line.startswith(("+++ ", "--- ")):
+            continue
+        elif line[:1] in ("+", "-") and line[1:].strip():
+            cur[0 if line[0] == "+" else 1].append(" ".join(line[1:].split()))
+    return out
+
+
+def minus(have, take):
+    """The lines of have left after taking away one copy of each line in take."""
+    left = list(have)
+    for t in take:
+        if t in left:
+            left.remove(t)
+    return left
+
+
+DEPARTURE_LIMIT = 20  # lines listed per file; the rest are counted
+
+
+def departures_item(project, base):
+    """QA mode (#471): the lines where the build differs from the approved drafts recorded in plan_page.
+    Pages under docs/plans/ and the stage file are not code, so they are left out."""
+    try:
+        with open(stage_file(project), encoding="utf-8") as f:
+            page = json.load(f).get("plan_page")
+    except (OSError, ValueError, AttributeError) as e:
+        page, why = None, "the stage file could not be read (%s)" % e
+    else:
+        why = "the stage file records no build plan page with drafts"
+    title = "Departures from the approved code"
+    if not isinstance(page, dict) or not page.get("drafts"):
+        return ["keep", title, "Not checked: no approved drafts", None,
+                "Departures could not be checked because %s." % why, None, None]
+    planned = {}
+    for rel in sorted(page["drafts"]):
+        try:
+            with open(os.path.join(project, rel), encoding="utf-8") as f:
+                text = f.read()
+        except OSError as e:
+            die("QA mode: the approved draft %s could not be read (%s); restore it from the branch history" % (rel, e))
+        for name, (a, r) in changed_lines(text).items():
+            planned.setdefault(name, ([], []))[0].extend(a)
+            planned[name][1].extend(r)
+    real = changed_lines(run_git(project, "diff", "-w", base + "...HEAD"))
+    rows, total = [], 0
+    for name in sorted(set(planned) | set(real)):
+        if name.startswith(("docs/plans/", ".claude/")):
+            continue
+        pa, pr = planned.get(name, ([], []))
+        ra, rr = real.get(name, ([], []))
+        parts = ([["Written, not in the draft: " + t, 1, 0] for t in minus(ra, pa)] +
+                 [["Removed, not in the draft: " + t, 0, 1] for t in minus(rr, pr)] +
+                 [["In the draft, not written: " + t, 0, 1] for t in minus(pa, ra)] +
+                 [["Draft removes it, the build kept it: " + t, 1, 0] for t in minus(pr, rr)])
+        if parts:
+            total += len(parts)
+            more = len(parts) - DEPARTURE_LIMIT
+            shown = parts[:DEPARTURE_LIMIT] + ([["... and %d more lines" % more, 0, 0]] if more > 0 else [])
+            rows.append([name, sum(x[1] for x in parts), sum(x[2] for x in parts), shown])
+    line = ("%d %s in %d %s differ from the drafts" % (total, "line" if total == 1 else "lines", len(rows),
+                                                      "file" if len(rows) == 1 else "files")
+            if rows else "None: the build matches the approved code")
+    return ["chg" if rows else "keep", title, line, None,
+            "Every line the build wrote or removed that the approved drafts did not, and every draft line the build "
+            "did not write, compared with spacing ignored, so reformatting and moved lines are not departures. "
+            "The builder's report gives the reason for each.", None, rows]
+
