+DEPARTURES_TITLE = "Departures from the approved code"
+DEPARTURES_SHOWN_PER_FILE = 20  # lines listed per file; the rest are counted
+NOT_CODE_FOLDERS = ("docs/plans/", ".claude/")  # pages, drafts and the stage file
+
+
+def changed_lines_by_file(diff_text):
+    """{file: (added lines, removed lines)} from a unified diff. Spacing inside each line is
+    collapsed and blank lines are left out, so reformatting never counts as a change."""
+    changes = {}
+    current_file = None
+    for line in diff_text.splitlines():
+        if line.startswith("diff --git "):
+            current_file = line.split(" b/", 1)[-1]
+            changes.setdefault(current_file, ([], []))
+            continue
+        is_before_first_file = current_file is None
+        is_file_header = line.startswith(("+++ ", "--- "))
+        is_change = line[:1] in ("+", "-") and bool(line[1:].strip())
+        if is_before_first_file or is_file_header or not is_change:
+            continue
+        collapsed = " ".join(line[1:].split())
+        added_lines, removed_lines = changes[current_file]
+        if line[0] == "+":
+            added_lines.append(collapsed)
+        else:
+            removed_lines.append(collapsed)
+    return changes
+
+
+def lines_missing_from(lines, other_lines):
+    """The lines that other_lines does not have, counting each repeated line separately."""
+    remaining = list(other_lines)
+    missing = []
+    for line in lines:
+        if line in remaining:
+            remaining.remove(line)
+        else:
+            missing.append(line)
+    return missing
+
+
+def approved_drafts(project):
+    """(the approved drafts' paths, or None, and why there are none) from the stage file."""
+    try:
+        with open(stage_file_path(project), encoding="utf-8") as stage_file:
+            plan_page = json.load(stage_file).get("plan_page")
+    except (OSError, ValueError, AttributeError) as error:
+        return None, "the stage file could not be read (%s)" % error
+    has_drafts = isinstance(plan_page, dict) and bool(plan_page.get("drafts"))
+    if not has_drafts:
+        return None, "the stage file records no build plan page with drafts"
+    return sorted(plan_page["drafts"]), ""
+
+
+def planned_lines_by_file(project, draft_paths):
+    """The changed lines of every approved draft, merged by file."""
+    planned = {}
+    for draft_path in draft_paths:
+        try:
+            with open(os.path.join(project, draft_path), encoding="utf-8") as draft_file:
+                draft_text = draft_file.read()
+        except OSError as error:
+            die("QA mode: the approved draft %s could not be read (%s); restore it from the "
+                "branch history" % (draft_path, error))
+        for file_name, (added_lines, removed_lines) in changed_lines_by_file(draft_text).items():
+            file_plan = planned.setdefault(file_name, ([], []))
+            file_plan[0].extend(added_lines)
+            file_plan[1].extend(removed_lines)
+    return planned
+
+
+def departures_in_file(planned, real):
+    """Each line where one file's build differs from its draft, as [description, added, removed]."""
+    planned_added, planned_removed = planned
+    real_added, real_removed = real
+    departures = []
+    for line in lines_missing_from(real_added, planned_added):
+        departures.append(["Written, not in the draft: " + line, 1, 0])
+    for line in lines_missing_from(real_removed, planned_removed):
+        departures.append(["Removed, not in the draft: " + line, 0, 1])
+    for line in lines_missing_from(planned_added, real_added):
+        departures.append(["In the draft, not written: " + line, 0, 1])
+    for line in lines_missing_from(planned_removed, real_removed):
+        departures.append(["The draft removes it, the build kept it: " + line, 1, 0])
+    return departures
+
+
+def departures_item(project, base):
+    """QA mode (#471): the Changes item listing every line where the build differs from the
+    approved drafts in plan_page, compared with spacing ignored."""
+    draft_paths, why_none = approved_drafts(project)
+    if draft_paths is None:
+        return ["keep", DEPARTURES_TITLE, "Not checked: no approved drafts", None,
+                "Departures could not be checked because %s." % why_none, None, None]
+    planned = planned_lines_by_file(project, draft_paths)
+    real = changed_lines_by_file(run_git(project, "diff", "-w", base + "...HEAD"))
+    rows = []
+    total_departures = 0
+    for file_name in sorted(set(planned) | set(real)):
+        if file_name.startswith(NOT_CODE_FOLDERS):
+            continue
+        no_change = ([], [])
+        departures = departures_in_file(planned.get(file_name, no_change),
+                                        real.get(file_name, no_change))
+        if not departures:
+            continue
+        total_departures += len(departures)
+        shown = departures[:DEPARTURES_SHOWN_PER_FILE]
+        hidden_count = len(departures) - len(shown)
+        if hidden_count:
+            shown.append(["... and %d more lines" % hidden_count, 0, 0])
+        added_count = sum(departure[1] for departure in departures)
+        removed_count = sum(departure[2] for departure in departures)
+        rows.append([file_name, added_count, removed_count, shown])
+    if rows:
+        tag = "chg"
+        summary = "%s in %s differ from the drafts" % (counted(total_departures, "line", "lines"),
+                                                       counted(len(rows), "file", "files"))
+    else:
+        tag = "keep"
+        summary = "None: the build matches the approved code"
+    detail = ("Every line the build wrote or removed that the approved drafts did not, and every "
+              "draft line the build did not write, compared with spacing ignored, so reformatting "
+              "and moved lines are not departures. The builder's report gives the reason for each.")
+    return [tag, DEPARTURES_TITLE, summary, None, detail, None, rows]
+
