@@ -0,0 +1,554 @@
+#!/usr/bin/env python3
+"""readability.py - checks that every line a diff adds is easy to read (#473).
+
+    readability.py check <draft.diff> [--project <root>]
+
+The six rules are the house coding standard in rules/standards/coding-philosophy.md:
+  1. Names say what they hold, in whole words.
+  2. One thing per line.
+  3. A condition with more than two parts becomes named yes-or-no values.
+  4. Lines are at most 100 characters.
+  5. Every new function starts with one plain sentence saying what it does.
+  6. No logic inside one-line lambdas or nested comprehensions.
+  7. Values sit inside the text they fill: f-strings, not percent placeholders.
+  8. Every pattern (regular expression) has a plain comment above it saying what it matches.
+
+Python and JavaScript lines are checked, including the script part of an HTML file.
+Markdown, JSON and CSS lines are only checked for length; the writing check reads prose.
+
+Exit codes: 0 every added line is readable, 1 a rule is broken (each problem is printed),
+2 bad input.
+
+STDLIB ONLY, Python 3.8+. Never installs anything.
+"""
+
+import os
+import re
+import sys
+
+MAX_LINE_LENGTH = 100
+MIN_WORD_LENGTH = 3
+
+# Short words a reader knows without guessing. Anything else shorter than three letters is refused.
+KNOWN_SHORT_WORDS = {"i", "j", "id", "ok", "os", "re", "_"}
+
+# Short connecting words that read naturally inside a longer name, such as links_an_artifact.
+# Alone, each is still too short to be a name.
+CONNECTING_WORDS = {"a", "an", "as", "at", "by", "if", "in", "is", "no", "of", "on", "or", "to",
+                    "up"}
+
+# Abbreviations so common they read as words.
+KNOWN_ABBREVIATIONS = {"url", "html", "json", "git", "sha", "css", "env", "args", "kwargs",
+                       "self", "cls", "sys", "api", "uri", "utf", "http", "https", "js", "py",
+                       "md", "pr", "gh", "qa"}
+
+# Abbreviations that make a reader guess. Each is refused even though it is three letters or more.
+GUESSWORK_ABBREVIATIONS = {"cfg", "msg", "tmp", "val", "idx", "cnt", "num", "obj", "arr",
+                           "btn", "ctx", "req", "res", "buf", "ptr", "src", "dst", "esc", "pkg",
+                           "opt", "opts", "seg", "ops", "rel", "pos", "len", "str", "dir", "elt",
+                           "itm", "lst", "dct", "fnc", "cmd", "iss", "mod"}
+
+SPLIT_STATEMENTS = "rule 2, one thing per line: put each statement joined by ; on its own line"
+NAME_THE_CONDITION = "rule 3, named conditions: give each part of this condition a yes-or-no name"
+NO_LAMBDA = "rule 6, no packed logic: write a named function instead of a lambda"
+NO_NESTED_LOOPS = "rule 6, no packed logic: write the nested comprehension as loops"
+NAME_THE_ARROW = "rule 6, no packed logic: give this one-line arrow function a name and a body"
+DESCRIBE_THE_FUNCTION = "rule 5, describe each function: open it with one plain sentence"
+VALUES_IN_PLACE = ("rule 7, values in place: write an f-string such as f\"step {name}\" instead of "
+                   "percent placeholders")
+EXPLAIN_THE_PATTERN = ("rule 8, explain patterns: put a plain comment above it saying "
+                       "what it matches")
+
+# What git writes in a unified diff: "diff --git a/<old path> b/<new path>" starts each file.
+# The lines "--- <old path>" then "+++ <new path>" name the old file, then the new one.
+FILE_START_MARKER = "diff --git "
+NEW_PATH_MARKER = " b/"
+OLD_FILE_MARKER = "--- "
+NEW_FILE_MARKER = "+++ "
+
+# A block header such as "@@ -12,3 +14,5 @@": captures the old and new start lines.
+HUNK_HEADER = re.compile(r"^@@ -(\d+)(?:,\d+)? \+(\d+)(?:,\d+)? @@")
+
+# A percent placeholder inside quoted text: a percent sign, optional width, then the value's type.
+PERCENT_PLACEHOLDER = re.compile(r"%[-+ 0-9.]*[sdrfxi]|%\(")
+
+# Quoted text followed by the percent operator that fills it.
+PERCENT_OPERATOR = re.compile(r"\"\"\s*[%](?!=)")
+
+# A Python pattern written out in place: re.compile(...) always, or another re call whose first
+# argument is quoted text. A pattern held in a named variable is explained where it is named.
+PYTHON_PATTERN_CALL = re.compile(
+    r"\bre\.compile\("
+    r"|\bre\.(?:search|match|fullmatch|findall|finditer|sub|split)\(\s*[rRbB]*[\"']")
+
+# A JavaScript pattern written between slashes, right after an opening bracket, comma or equals.
+JAVASCRIPT_PATTERN = re.compile(r"[(,=]\s*/[^/*\s][^/]*/[gimsuy]*")
+
+# A private helper's name: an underscore, then a letter. Attribute access (.name) is not one.
+PRIVATE_NAME = re.compile(r"(?<![\w.])_[A-Za-z]\w*")
+
+# A line that only gives an old private helper a new name: readable_name = _old_name
+ALIAS_LINE = re.compile(r"^\s*([A-Za-z]\w*)\s*=\s*_[A-Za-z]\w*\s*(?:#.*)?$")
+
+# Any name in a line of code.
+ANY_NAME = re.compile(r"[A-Za-z_$][\w$]*")
+
+PYTHON_EXTENSIONS = (".py",)
+JAVASCRIPT_EXTENSIONS = (".js", ".mjs", ".ts", ".tsx", ".jsx")
+HTML_EXTENSIONS = (".html", ".htm")
+
+# A quoted piece of text: single quotes or double quotes, with backslash escapes allowed inside.
+STRING_LITERAL = re.compile(r"'(?:[^'\\]|\\.)*'|\"(?:[^\"\\]|\\.)*\"")
+# The start of a triple-quoted string, with a prefix letter like r in front.
+# Where a triple-quoted string opens: an optional r, b, u or f prefix, then three quotes.
+BLOCK_STRING_START = re.compile(r"[rRbBuUfF]*(\"\"\"|''')")
+# One Python name, or several separated by commas: "a" or "first, second".
+PYTHON_NAME_LIST =r"([A-Za-z_]\w*(?:\s*,\s*[A-Za-z_]\w*)*)"
+# A Python line that assigns to one or more names: "total = 0" or "first, second = pair".
+PYTHON_ASSIGNMENT = re.compile(r"^\s*" + PYTHON_NAME_LIST + r"\s*(?:[-+*/]?=)(?!=)")
+# A Python function definition: its name, then the text of its parameters.
+PYTHON_FUNCTION = re.compile(r"^\s*(?:async\s+)?def\s+([A-Za-z_]\w*)\s*\(([^)]*)")
+# The names a Python "for ... in" loop creates.
+PYTHON_LOOP_NAMES = re.compile(r"\bfor\s+" + PYTHON_NAME_LIST + r"\s+in\b")
+# The name after "as", in "with ... as name" or "except ... as name".
+PYTHON_AS_NAME = re.compile(r"\bas\s+([A-Za-z_]\w*)")
+# The name a JavaScript const, let or var declares.
+JAVASCRIPT_DECLARATION = re.compile(r"\b(?:const|let|var)\s+([A-Za-z_$][\w$]*)")
+# A JavaScript function definition: its name, then the text of its parameters.
+JAVASCRIPT_FUNCTION = re.compile(r"\bfunction\s+([A-Za-z_$][\w$]*)\s*\(([^)]*)")
+# The parameters before an arrow (=>): either "(a, b)" or a single bare name.
+JAVASCRIPT_ARROW_PARAMETERS = re.compile(r"(?:\(([^()]*)\)|\b([A-Za-z_$][\w$]*))\s*=>")
+# A named arrow function with a body: "const name = (...) => {".
+JAVASCRIPT_ARROW_FUNCTION = re.compile(
+    r"\b(?:const|let)\s+[A-Za-z_$][\w$]*\s*=\s*(?:async\s*)?\([^)]*\)\s*=>\s*\{")
+# A condition part that is already a yes-or-no name: "is_ready", "not is_done" or "!isDone".
+PLAIN_NAME = re.compile(r"^\(?\s*(?:not\s+|!)?[A-Za-z_$][\w$.]*[\s),;]*$")
+# The point between a lower-case letter or digit and the capital that starts the next word.
+CAMEL_CASE_BOUNDARY = re.compile(r"(?<=[a-z0-9])(?=[A-Z])")
+
+
+def words_in_name(name):
+    """The words a name is made of: split on underscores and on camelCase capitals."""
+    words = []
+    for piece in name.strip("_$").split("_"):
+        words.extend(CAMEL_CASE_BOUNDARY.split(piece))
+    return [word.lower() for word in words if word]
+
+
+def name_problem(name):
+    """Why a name makes the reader guess, or "" when it says what it holds."""
+    if name in KNOWN_SHORT_WORDS:
+        return ""
+    words = words_in_name(name)
+    has_several_words = len(words) > 1
+    for word in words:
+        is_known_word = word in KNOWN_SHORT_WORDS or word in KNOWN_ABBREVIATIONS
+        is_connecting_word = has_several_words and word in CONNECTING_WORDS
+        is_number = word.isdigit()
+        if is_known_word or is_connecting_word or is_number:
+            continue
+        if word in GUESSWORK_ABBREVIATIONS:
+            return f'"{word}" is an abbreviation; write the whole word'
+        if len(word) < MIN_WORD_LENGTH:
+            return f'"{word}" is too short to say what it holds'
+    return ""
+
+
+def parameter_names(parameter_text):
+    """The names in a parameter list such as "items, count=0, *rest"."""
+    names = []
+    for parameter in parameter_text.split(","):
+        bare = parameter.split("=")[0].split(":")[0].strip().lstrip("*").strip()
+        # A whole parameter that is one plain name.
+        if re.match(r"^[A-Za-z_$][\w$]*$", bare):
+            names.append(bare)
+    return names
+
+
+def without_strings(line):
+    """The line with the inside of every quoted string blanked, so code rules never read text.
+    A triple-quoted string that opens on this line is blanked to the end of the line."""
+    block_start = BLOCK_STRING_START.search(line)
+    if block_start:
+        line = line[:block_start.start()] + '""'
+    return STRING_LITERAL.sub('""', line)
+
+
+def names_bound_in_python(code):
+    """Every name a Python line creates: assignments, functions, parameters, loops and "as"."""
+    names = []
+    assignment = PYTHON_ASSIGNMENT.match(code)
+    if assignment:
+        names.extend(part.strip() for part in assignment.group(1).split(","))
+    function = PYTHON_FUNCTION.match(code)
+    if function:
+        names.append(function.group(1))
+        names.extend(parameter_names(function.group(2)))
+    for loop in PYTHON_LOOP_NAMES.finditer(code):
+        names.extend(part.strip() for part in loop.group(1).split(","))
+    names.extend(PYTHON_AS_NAME.findall(code))
+    return names
+
+
+def names_bound_in_javascript(code):
+    """Every name a JavaScript line creates: declarations, functions and arrow parameters."""
+    names = list(JAVASCRIPT_DECLARATION.findall(code))
+    for function in JAVASCRIPT_FUNCTION.finditer(code):
+        names.append(function.group(1))
+        names.extend(parameter_names(function.group(2)))
+    for arrow in JAVASCRIPT_ARROW_PARAMETERS.finditer(code):
+        bracketed_parameters, single_parameter = arrow.groups()
+        if bracketed_parameters is not None:
+            names.extend(parameter_names(bracketed_parameters))
+        elif single_parameter:
+            names.append(single_parameter)
+    return names
+
+
+def has_unnamed_condition(code, joiner_pattern):
+    """True when a condition joins three or more parts and one is not a plain yes-or-no name."""
+    # The condition is whatever follows the last if, while, return or single equals sign.
+    condition = re.split(r"\bif\b|\bwhile\b|\breturn\b|=(?!=)", code)[-1].rstrip(":{ ")
+    parts = re.split(joiner_pattern, condition)
+    if len(parts) < 3:
+        return False
+    return not all(PLAIN_NAME.match(part.strip()) for part in parts)
+
+
+def older_helper_problems(code, existing_names):
+    """Rule 1 for an older private helper that new code calls: it needs a readable name too.
+    A helper the same change also removes or already used is left to the clean-up issue, and a
+    line that only gives an old helper a readable name (run_git_in = _mp_git) is the fix itself."""
+    alias = ALIAS_LINE.match(code)
+    if alias and not name_problem(alias.group(1)):
+        return []
+    problems = []
+    for helper_name in sorted(set(PRIVATE_NAME.findall(code))):
+        if helper_name in existing_names:
+            continue
+        why = name_problem(helper_name)
+        if why:
+            problems.append(f"rule 1, whole-word names: the older helper {helper_name}: {why}; "
+                            "give it a readable name where new code calls it")
+    return problems
+
+
+def text_problems(line):
+    """Rule 7 for one line of Python, read with its quoted text still in place."""
+    for quoted in STRING_LITERAL.findall(line):
+        is_format_string = line[:line.find(quoted)].rstrip().endswith(("f", "rf", "fr"))
+        if PERCENT_PLACEHOLDER.search(quoted) and not is_format_string:
+            return [VALUES_IN_PLACE]
+    return []
+
+
+def python_problems(code, existing_names):
+    """Rules 1, 2, 3 and 6 for one line of Python with its strings blanked. Names in
+    existing_names were already in the file, so rule 1 leaves them to the clean-up issue."""
+    problems = []
+    for name in names_bound_in_python(code):
+        if name in existing_names:
+            continue
+        why = name_problem(name)
+        if why:
+            problems.append(f"rule 1, whole-word names: {why}")
+    problems.extend(older_helper_problems(code, existing_names))
+    if PERCENT_OPERATOR.search(code):
+        problems.append(VALUES_IN_PLACE)
+    if ";" in code.split("#")[0]:
+        problems.append(SPLIT_STATEMENTS)
+    if has_unnamed_condition(code, r"\band\b|\bor\b"):
+        problems.append(NAME_THE_CONDITION)
+    # The word lambda.
+    if re.search(r"\blambda\b", code):
+        problems.append(NO_LAMBDA)
+    # A leading "for" starts a loop statement, so only the fors after it are comprehensions.
+    expression = re.sub(r"^\s*for\b", "", code)
+    # Each remaining word for.
+    if len(re.findall(r"\bfor\b", expression)) >= 2:
+        problems.append(NO_NESTED_LOOPS)
+    return problems
+
+
+def javascript_problems(code, existing_names):
+    """Rules 1, 2, 3 and 6 for one line of JavaScript with its strings blanked. Names in
+    existing_names were already in the file, so rule 1 leaves them to the clean-up issue."""
+    problems = []
+    for name in names_bound_in_javascript(code):
+        if name in existing_names:
+            continue
+        why = name_problem(name)
+        if why:
+            problems.append(f"rule 1, whole-word names: {why}")
+    problems.extend(older_helper_problems(code, existing_names))
+    # A for loop's brackets hold semicolons that belong together, so they are emptied first.
+    statement_part = re.sub(r"\bfor\s*\([^)]*\)", "for ()", code.split("//")[0]).rstrip()
+    if ";" in statement_part.rstrip(";"):
+        problems.append(SPLIT_STATEMENTS)
+    if has_unnamed_condition(code, r"&&|\|\|"):
+        problems.append(NAME_THE_CONDITION)
+    if "=>" in code:
+        arrow_body = code.split("=>", 1)[1]
+        has_choice = "?" in arrow_body and ":" in arrow_body
+        has_condition = "&&" in arrow_body or "||" in arrow_body
+        has_nested_arrow = "=>" in arrow_body
+        if has_choice or has_condition or has_nested_arrow:
+            problems.append(NAME_THE_ARROW)
+    return problems
+
+
+def language_of(file_name):
+    """ "python", "javascript", "html" or "" for a file the code rules do not read."""
+    if file_name.endswith(PYTHON_EXTENSIONS):
+        return "python"
+    if file_name.endswith(JAVASCRIPT_EXTENSIONS):
+        return "javascript"
+    if file_name.endswith(HTML_EXTENSIONS):
+        return "html"
+    return ""
+
+
+TRIPLE_QUOTES = ('"""', "'''")
+
+
+def python_block_quote_after(line, open_block_quote):
+    """Which triple quote is still open after this line ("" for none). Reads the line one character
+    at a time, so a triple quote written inside an ordinary string does not count."""
+    position = 0
+    open_single_quote = ""
+    while position < len(line):
+        character = line[position]
+        three_characters = line[position:position + 3]
+        if open_block_quote:
+            if three_characters == open_block_quote:
+                open_block_quote = ""
+                position += 3
+                continue
+            position += 2 if character == "\\" else 1
+            continue
+        if open_single_quote:
+            if character == "\\":
+                position += 2
+                continue
+            if character == open_single_quote:
+                open_single_quote = ""
+            position += 1
+            continue
+        if character == "#":
+            break
+        if three_characters in TRIPLE_QUOTES:
+            open_block_quote = three_characters
+            position += 3
+            continue
+        if character in ("'", '"'):
+            open_single_quote = character
+        position += 1
+    return open_block_quote
+
+
+class LineState:
+    """Where a line sits in its file: inside a multi-line string, and, in HTML, inside a script."""
+
+    def __init__(self):
+        """Start outside every string and script, as at the top of a file."""
+        self.in_python_block_string = False
+        self.python_block_quote = ""
+        self.in_javascript_template = False
+        self.in_html_script = False
+
+    def is_code(self, language):
+        """True when the next line is code the rules read, not text in a string or HTML."""
+        if language == "python":
+            return not self.in_python_block_string
+        if language == "javascript":
+            return not self.in_javascript_template
+        if language == "html":
+            return self.in_html_script and not self.in_javascript_template
+        return False
+
+    def move_past(self, line, language):
+        """Update the state for what this line opens or closes."""
+        if language == "python":
+            self.python_block_quote = python_block_quote_after(line, self.python_block_quote)
+            self.in_python_block_string = bool(self.python_block_quote)
+            return
+        if language == "html":
+            # An opening script tag.
+            if re.search(r"<script\b", line, re.IGNORECASE):
+                self.in_html_script = True
+            # A closing script tag.
+            if re.search(r"</script>", line, re.IGNORECASE):
+                self.in_html_script = False
+        # Each backtick that is not escaped with a backslash.
+        backticks = len(re.findall(r"(?<!\\)`", line))
+        if backticks % 2 == 1:
+            self.in_javascript_template = not self.in_javascript_template
+
+
+def state_before_line(original_lines, line_number, language):
+    """The LineState at a line of the original file, found by reading every line above it."""
+    state = LineState()
+    for line in original_lines[:max(0, line_number - 1)]:
+        state.move_past(line, language)
+    return state
+
+
+def read_original_file(project, file_name):
+    """The file's lines before the diff, or [] when it is new or can't be read."""
+    try:
+        with open(os.path.join(project, file_name), encoding="utf-8") as original:
+            return original.read().splitlines()
+    except (OSError, UnicodeDecodeError):
+        return []
+
+
+def function_description_problem(added_line, next_lines, previous_line, language):
+    """Rule 5: why a new function has no plain description, or ""."""
+    is_python_function = language == "python" and PYTHON_FUNCTION.match(added_line)
+    is_javascript_function = language in ("javascript", "html") and (
+        JAVASCRIPT_FUNCTION.search(added_line) or JAVASCRIPT_ARROW_FUNCTION.search(added_line))
+    if not (is_python_function or is_javascript_function):
+        return ""
+    previous_is_comment = previous_line.strip().startswith(("#", "//", "/*", "*"))
+    if previous_is_comment:
+        return ""
+    if is_python_function:
+        body_lines = [line.strip() for line in next_lines if line.strip()]
+        first_body_line = body_lines[0] if body_lines else ""
+        if first_body_line.startswith(('"""', "'''", "#")):
+            return ""
+    return DESCRIBE_THE_FUNCTION
+
+
+def names_in_removed_lines(lines, language):
+    """Every name the hunk's removed lines bind: names that existed before this change."""
+    names = set()
+    for kind, text in lines:
+        if kind != "-":
+            continue
+        code = without_strings(text)
+        names.update(ANY_NAME.findall(code))
+    return names
+
+
+def without_comment(code, language):
+    """The code part of a line whose quoted text is blanked: a comment is prose, not code."""
+    comment_mark = "#" if language == "python" else "//"
+    return code.split(comment_mark, 1)[0]
+
+
+def pattern_lacks_comment(code, previous_line, language):
+    """Rule 8: True when this line writes a pattern with no plain comment above it or after it."""
+    if language == "python":
+        writes_pattern = bool(PYTHON_PATTERN_CALL.search(code))
+    else:
+        writes_pattern = bool(JAVASCRIPT_PATTERN.search(code))
+    if not writes_pattern:
+        return False
+    comment_above = previous_line.strip().startswith(("#", "//"))
+    comment_after = "#" in code or "//" in code
+    return not (comment_above or comment_after)
+
+
+def problems_in_file(file_name, hunks, project, read_file=None):
+    """Every rule broken by the lines this file's hunks add, as "file:line: problem" strings."""
+    language = language_of(file_name)
+    if read_file is None:
+        original_lines = read_original_file(project, file_name)
+    else:
+        original_lines = read_file(file_name)
+    problems = []
+    for old_start, new_start, lines in hunks:
+        state = state_before_line(original_lines, old_start, language)
+        new_line_number = new_start
+        new_side = [(kind, text) for kind, text in lines if kind != "-"]
+        existing_names = names_in_removed_lines(lines, language)
+        for position, (kind, text) in enumerate(new_side):
+            is_added = kind == "+"
+            is_code = state.is_code(language)
+            if is_added:
+                where = f"{file_name}:{new_line_number}"
+                is_table_row = file_name.endswith(".md") and text.lstrip().startswith("|")
+                if len(text) > MAX_LINE_LENGTH and not is_table_row:
+                    problems.append(f"{where}: rule 4, short lines: {len(text)} characters, "
+                                    f"at most {MAX_LINE_LENGTH}")
+                if is_code:
+                    code_and_comment = without_strings(text)
+                    code = without_comment(code_and_comment, language)
+                    if language == "python":
+                        line_problems = python_problems(code, existing_names)
+                    else:
+                        line_problems = javascript_problems(code, existing_names)
+                    previous_line = new_side[position - 1][1] if position else ""
+                    next_lines = [line for _, line in new_side[position + 1:position + 4]]
+                    description = function_description_problem(
+                        text, next_lines, previous_line, language)
+                    if description:
+                        line_problems.append(description)
+                    if language == "python":
+                        line_problems.extend(text_problems(text))
+                    if pattern_lacks_comment(code_and_comment, previous_line, language):
+                        line_problems.append(EXPLAIN_THE_PATTERN)
+                    problems.extend(f"{where}: {problem}" for problem in line_problems)
+            state.move_past(text, language)
+            new_line_number += 1
+    return problems
+
+
+def hunks_by_file(diff_text):
+    """{file: [(old start, new start, [(kind, text), ...]), ...]} from a unified diff."""
+    files = {}
+    current_file = None
+    for line in diff_text.splitlines():
+        if line.startswith(FILE_START_MARKER):
+            current_file = line.split(NEW_PATH_MARKER, 1)[-1]
+            files[current_file] = []
+            continue
+        header = HUNK_HEADER.match(line)
+        if header and current_file is not None:
+            files[current_file].append((int(header.group(1)), int(header.group(2)), []))
+            continue
+        is_file_header = line.startswith((OLD_FILE_MARKER, NEW_FILE_MARKER, "index ", "new file",
+                                          "deleted file"))
+        is_before_first_hunk = current_file is None or not files[current_file]
+        if is_before_first_hunk or is_file_header:
+            continue
+        kind = line[:1] if line[:1] in ("+", "-", " ") else " "
+        files[current_file][-1][2].append((kind, line[1:]))
+    return files
+
+
+def find_problems(diff_text, project, read_file=None):
+    """Every readability problem in the lines a unified diff adds, in file order."""
+    problems = []
+    for file_name, hunks in hunks_by_file(diff_text).items():
+        problems.extend(problems_in_file(file_name, hunks, project, read_file))
+    return problems
+
+
+def main(arguments):
+    """Command line: check one draft and print each problem."""
+    if len(arguments) < 2 or arguments[0] != "check":
+        print(__doc__.strip().splitlines()[2].strip())
+        return 2
+    project = os.getcwd()
+    if "--project" in arguments:
+        project = arguments[arguments.index("--project") + 1]
+    try:
+        with open(arguments[1], encoding="utf-8") as draft:
+            diff_text = draft.read()
+    except OSError as error:
+        print(f"readability: could not read {arguments[1]}: {error}")
+        return 2
+    problems = find_problems(diff_text, project)
+    for problem in problems:
+        print(problem)
+    if problems:
+        print(f"readability: {len(problems)} problem(s) in {arguments[1]}")
+        return 1
+    print(f"readability: every added line in {arguments[1]} is readable")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv[1:]))
