+    ("rule 4: a line over 100 characters is refused",
+     flags_rule(4, "notes.md", ["word " * 25])),
+    ("rule 4: a Markdown table row may run long, because it cannot wrap",
+     passes_check("notes.md", ["| " + "cell | " * 30])),
+    ("rule 7: a percent placeholder is refused; the same text as an f-string passes",
+     flags_rule(7, "app.py", [f'note = "step {PERCENT_SIGN}s failed" {PERCENT_SIGN} step_name'])
