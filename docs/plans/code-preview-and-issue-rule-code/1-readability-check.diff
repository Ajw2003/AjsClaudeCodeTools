+++ b/claude-house-rules/plugins/house-rules/scripts/house_rules/readable_patterns.py
@@ -0,0 +1,134 @@
+#!/usr/bin/env python3
+"""readable_patterns.py - builds patterns (regular expressions) from named pieces, so each one reads as a sentence (#473).
+
+    PYTHON_FUNCTION = pattern(line_start, optional_spaces, optional("async", spaces), "def", spaces, capture(PYTHON_NAME), optional_spaces, "(")
+
+Plain text given to pattern() means exactly that text: "def" matches the three letters d, e and f.
+A Piece is a ready-made part with a name, such as spaces or PYTHON_NAME, and is used as it is.
+
+This file is the one place where raw pattern syntax is written. Everywhere else builds patterns from these pieces,
+and the readability check (scripts/readability.py, rule 8) refuses raw pattern text anywhere else.
+
+STDLIB ONLY, Python 3.8+. Never installs anything.
+"""
+
+import re
+
+
+class Piece(str):
+    """A ready-made part of a pattern. Plain text is matched exactly; a Piece is used as it is."""
+
+
+def as_piece(part):
+    """A Piece unchanged, or plain text turned into a Piece that matches exactly that text."""
+    if isinstance(part, Piece):
+        return part
+    return Piece(re.escape(part))
+
+
+def sequence(*parts):
+    """The parts, one straight after another."""
+    return Piece("".join(as_piece(part) for part in parts))
+
+
+def pattern(*parts, ignore_case=False, every_line=False):
+    """A finished pattern matching the parts one after another. every_line lets line_start and line_end match at each line of a longer text."""
+    flags = 0
+    if ignore_case:
+        flags = flags | re.IGNORECASE
+    if every_line:
+        flags = flags | re.MULTILINE
+    return re.compile(sequence(*parts), flags)
+
+
+def capture(*parts):
+    """The parts, kept so the match hands them back as a numbered group."""
+    return Piece("(" + sequence(*parts) + ")")
+
+
+def optional(*parts):
+    """The parts, or nothing at all."""
+    return Piece("(?:" + sequence(*parts) + ")?")
+
+
+def any_of(*choices):
+    """Any one of the choices."""
+    return Piece("(?:" + "|".join(as_piece(choice) for choice in choices) + ")")
+
+
+def one_or_more(*parts):
+    """The parts, once or several times in a row."""
+    return Piece("(?:" + sequence(*parts) + ")+")
+
+
+def zero_or_more(*parts):
+    """The parts, any number of times in a row, including none."""
+    return Piece("(?:" + sequence(*parts) + ")*")
+
+
+def one_character_from(characters):
+    """Exactly one character, which is one of these characters."""
+    return Piece("[" + re.escape(characters) + "]")
+
+
+def one_character_except(characters):
+    """Exactly one character, which is not one of these characters."""
+    return Piece("[^" + re.escape(characters) + "]")
+
+
+def anything_except(characters):
+    """Any run of characters, including none, in which none is one of these characters."""
+    return Piece("[^" + re.escape(characters) + "]*")
+
+
+def followed_by(*parts):
+    """Matches nothing itself, but only where the parts come next."""
+    return Piece("(?=" + sequence(*parts) + ")")
+
+
+def not_followed_by(*parts):
+    """Matches nothing itself, but only where the parts do not come next."""
+    return Piece("(?!" + sequence(*parts) + ")")
+
+
+def preceded_by(*parts):
+    """Matches nothing itself, but only where the parts come just before."""
+    return Piece("(?<=" + sequence(*parts) + ")")
+
+
+def not_preceded_by(*parts):
+    """Matches nothing itself, but only where the parts do not come just before."""
+    return Piece("(?<!" + sequence(*parts) + ")")
+
+
+# Where a line starts and ends.
+line_start = Piece("^")
+line_end = Piece("$")
+
+# The edge of a word: between a letter, digit or underscore and anything else.
+word_edge = Piece(r"\b")
+
+# One space, tab or line break; one or more of them; or any number including none.
+space = Piece(r"\s")
+spaces = Piece(r"\s+")
+optional_spaces = Piece(r"\s*")
+
+# One or more digits, such as 42.
+digits = Piece(r"\d+")
+
+# Any one character, and the rest of a line.
+any_character = Piece(".")
+rest_of_line = Piece(".*")
+
+# A letter or digit in lower case, and a capital letter.
+lower_case_letter_or_digit = Piece("[a-z0-9]")
+capital_letter = Piece("[A-Z]")
+
+# A Python name, such as step_size; and a JavaScript name, which may also use $.
+PYTHON_NAME = Piece(r"[A-Za-z_]\w*")
+JAVASCRIPT_NAME = Piece(r"[A-Za-z_$][\w$]*")
+
+# One letter in either case; one letter, digit or underscore; and any number of those in a row.
+letter = Piece("[A-Za-z]")
+word_character = Piece(r"\w")
+word_characters = Piece(r"\w*")
