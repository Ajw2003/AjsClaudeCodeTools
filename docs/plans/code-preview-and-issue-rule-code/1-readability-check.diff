+# What git writes in a diff: "diff --git a/<old path> b/<new path>" starts each file, then
+# "--- <old path>" and "+++ <new path>" name the files, then "@@ -<old> +<new> @@" starts a hunk.
+FILE_START_MARKER = "diff --git "
+NEW_PATH_MARKER = " b/"
+OLD_FILE_MARKER = "--- "
+NEW_FILE_MARKER = "+++ "
+HUNK_MARKER = "@@"
+# A percent sign, kept out of the quoted test text below so the rule 7 test can name it.
