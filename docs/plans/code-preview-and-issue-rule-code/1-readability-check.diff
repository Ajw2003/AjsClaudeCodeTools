+
+def diff_adding(file_name, added_lines):
+    """A unified diff that creates file_name holding exactly added_lines."""
+    file_start = f"{FILE_START_MARKER}a/{file_name}{NEW_PATH_MARKER}{file_name}"
+    hunk_header = f"{HUNK_MARKER} -0,0 +1,{len(added_lines)} {HUNK_MARKER}"
+    header = [file_start, "new file mode 100644", f"{OLD_FILE_MARKER}/dev/null",
+              f"{NEW_FILE_MARKER}b/{file_name}", hunk_header]
+    body = ["+" + line for line in added_lines]
+    return "\n".join(header + body) + "\n"
+
+
+def diff_changing(file_name, removed_lines, added_lines):
+    """A unified diff that replaces removed_lines with added_lines in an existing file."""
+    file_start = f"{FILE_START_MARKER}a/{file_name}{NEW_PATH_MARKER}{file_name}"
+    hunk_header = (f"{HUNK_MARKER} -1,{len(removed_lines)} +1,{len(added_lines)} {HUNK_MARKER}")
+    header = [file_start, f"{OLD_FILE_MARKER}a/{file_name}", f"{NEW_FILE_MARKER}b/{file_name}",
+              hunk_header]
+    removed_body = ["-" + line for line in removed_lines]
+    added_body = ["+" + line for line in added_lines]
+    body = removed_body + added_body
+    return "\n".join(header + body) + "\n"
+
+
+def readability_findings(file_name, added_lines):
+    """What readability.py prints for a diff that adds these lines, and its exit code."""
+    draft_path = os.path.join(readability_project, "draft.diff")
+    with open(draft_path, "w", encoding="utf-8") as draft_file:
+        changes_existing_lines = any(line.startswith(("-", "+")) for line in added_lines)
+        if changes_existing_lines:
+            removed_lines = [line[1:] for line in added_lines if line.startswith("-")]
+            new_lines = [line[1:] for line in added_lines if line.startswith("+")]
+            draft_file.write(diff_changing(file_name, removed_lines, new_lines))
+        else:
+            draft_file.write(diff_adding(file_name, added_lines))
+    command = [sys.executable, READABILITY, "check", draft_path, "--project", readability_project]
+    finished = subprocess.run(command, capture_output=True, text=True, timeout=60)
+    return finished.returncode, finished.stdout
+
+
+def flags_rule(rule_number, file_name, added_lines):
+    """True when the check refuses these lines and names this rule."""
+    exit_code, findings = readability_findings(file_name, added_lines)
+    names_the_rule = f"rule {rule_number}," in findings
+    return exit_code == 1 and names_the_rule
+
+
+def passes_check(file_name, added_lines):
+    """True when the check finds every one of these lines readable."""
+    exit_code, findings = readability_findings(file_name, added_lines)
+    return exit_code == 0 and "is readable" in findings
+
