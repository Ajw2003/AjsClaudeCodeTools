+def diff_adding(file_name, added_lines):
+    """A unified diff that creates file_name holding exactly added_lines."""
+    file_start = f"{FILE_START_MARKER}a/{file_name}{NEW_PATH_MARKER}{file_name}"
+    hunk_header = f"{HUNK_MARKER} -0,0 +1,{len(added_lines)} {HUNK_MARKER}"
+    header = [file_start, "new file mode 100644", f"{OLD_FILE_MARKER}/dev/null", f"{NEW_FILE_MARKER}b/{file_name}", hunk_header]
+    body = ["+" + line for line in added_lines]
+    return "\n".join(header + body) + "\n"
+
+
+def diff_changing(file_name, removed_lines, added_lines):
+    """A unified diff that replaces removed_lines with added_lines in an existing file."""
+    file_start = f"{FILE_START_MARKER}a/{file_name}{NEW_PATH_MARKER}{file_name}"
+    hunk_header = f"{HUNK_MARKER} -1,{len(removed_lines)} +1,{len(added_lines)} {HUNK_MARKER}"
+    header = [file_start, f"{OLD_FILE_MARKER}a/{file_name}", f"{NEW_FILE_MARKER}b/{file_name}", hunk_header]
+    removed_body = ["-" + line for line in removed_lines]
+    added_body = ["+" + line for line in added_lines]
+    body = removed_body + added_body
+    return "\n".join(header + body) + "\n"
+
+
+def readability_findings(file_name, added_lines):
