+#!/usr/bin/env python3
+"""readability.py - checks that every line a diff adds is easy to read (#473).
+
+    readability.py check <draft.diff> [--project <root>]
+
+The eight rules are the house coding standard in rules/standards/coding-philosophy.md:
+  1. Names say what they hold, in whole words.
+  2. One thing per line.
+  3. A condition with more than two parts becomes named yes-or-no values.
+  4. One line per statement: a statement is never split across lines, however long the line gets.
+  5. Every new function starts with one plain sentence saying what it does.
+  6. No logic inside one-line lambdas or nested comprehensions.
+  7. Values sit inside the text they fill: f-strings and $"..." strings, not placeholders.
+  8. Patterns (regular expressions) are built from named pieces, never written as raw pattern text.
+
+Python, JavaScript and C# lines are checked, including the script part of an HTML file.
+Markdown, JSON and CSS lines are not checked; the writing check reads prose.
+
+Exit codes: 0 every added line is readable, 1 a rule is broken (each problem is printed),
+2 bad input.
+
+STDLIB ONLY, Python 3.8+. Never installs anything.
+"""
+
+import os
+import sys
+
+from house_rules.readable_patterns import PYTHON_NAME, JAVASCRIPT_NAME, any_character, any_of, anything_except, capital_letter, capture, digits, followed_by, letter, line_end, line_start, lower_case_letter_or_digit, not_followed_by, not_preceded_by, one_character_except, one_character_from, one_or_more, optional, optional_spaces, pattern, preceded_by, rest_of_line, sequence, space, spaces, word_character, word_characters, word_edge, zero_or_more
+
+MIN_WORD_LENGTH = 3
+
+# Short words a reader knows without guessing. Anything else shorter than three letters is refused.
+KNOWN_SHORT_WORDS = {"i", "j", "id", "ok", "os", "re", "_"}
+
+# Short connecting words that read naturally inside a longer name, such as links_an_artifact. Alone, each is still too short to be a name.
+CONNECTING_WORDS = {"a", "an", "as", "at", "by", "if", "in", "is", "no", "of", "on", "or", "to", "up"}
+
+# Abbreviations so common they read as words.
+KNOWN_ABBREVIATIONS = {"url", "html", "json", "git", "sha", "css", "env", "args", "kwargs", "self", "cls", "sys", "api", "uri", "utf", "http", "https", "js", "py", "md", "pr", "gh", "qa"}
+
+# Abbreviations that make a reader guess. Each is refused even though it is three letters or more.
+GUESSWORK_ABBREVIATIONS = {"cfg", "msg", "tmp", "val", "idx", "cnt", "num", "obj", "arr", "btn", "ctx", "req", "res", "buf", "ptr", "src", "dst", "esc", "pkg", "opt", "opts", "seg", "ops", "rel", "pos", "len", "str", "dir", "elt", "itm", "lst", "dct", "fnc", "cmd", "iss", "mod"}
+
+SPLIT_STATEMENTS = "rule 2, one thing per line: put each statement joined by ; on its own line"
+JOIN_THE_TEXT = "rule 4, one line per statement: join these side-by-side quoted texts into one"
+NAME_THE_CONDITION = "rule 3, named conditions: give each part of this condition a yes-or-no name"
+KEEP_ON_ONE_LINE = "rule 4, one line per statement: keep this statement on one line, even if it is long"
+NO_LAMBDA = "rule 6, no packed logic: write a named function instead of a lambda"
+NO_NESTED_LOOPS = "rule 6, no packed logic: write the nested comprehension as loops"
+NAME_THE_ARROW = "rule 6, no packed logic: give this one-line arrow function a name and a body"
+DESCRIBE_THE_FUNCTION = "rule 5, describe each function: open it with one plain sentence"
+VALUES_IN_PLACE = 'rule 7, values in place: write an f-string such as f"step {name}" instead of percent placeholders'
+VALUES_IN_PLACE_CSHARP = 'rule 7, values in place: write an interpolated string such as $"step {name}"'
+USE_NAMED_PIECES = "rule 8, patterns from named pieces: build it with readable_patterns.pattern(...) instead of raw pattern text"
+NO_CSHARP_BUILDER = "rule 8, patterns from named pieces: C# has no pattern builder yet; it comes with the readable-code skill, issue #474"
+
+# The one file that may write raw pattern text, because it is where the named pieces are made.
+PATTERN_BUILDER_FILE = "readable_patterns.py"
+
+# What git writes in a unified diff: "diff --git a/<old path> b/<new path>" starts each file.
+# The lines "--- <old path>" then "+++ <new path>" name the old file, then the new one.
+FILE_START_MARKER = "diff --git "
+NEW_PATH_MARKER = " b/"
+OLD_FILE_MARKER = "--- "
+NEW_FILE_MARKER = "+++ "
+
+# A block header such as "@@ -12,3 +14,5 @@": captures the old and new start lines.
+HUNK_HEADER = pattern(line_start, "@@ -", capture(digits), optional(",", digits), " +", capture(digits), optional(",", digits), " @@")
+
+# A percent placeholder inside quoted text: a percent sign, optional width, then the value's type; or a percent sign and an opening bracket.
+PERCENT_PLACEHOLDER = pattern(any_of(sequence("%", zero_or_more(one_character_from("-+ 0123456789.")), one_character_from("sdrfxi")), sequence("%", "(")))
+
+# Quoted text followed by the percent operator that fills it.
+PERCENT_OPERATOR = pattern('""', optional_spaces, "%", not_followed_by("="))
+
+# A C# composite placeholder inside quoted text, such as {0}, {1:N2} or {2,8}.
+COMPOSITE_PLACEHOLDER = pattern("{", digits, optional(any_of(",", ":"), anything_except("}")), "}")
+
+# A call to C#'s string.Format, which fills composite placeholders.
+CSHARP_FORMAT_CALL = pattern(word_edge, any_of("string", "String"), ".Format", optional_spaces, "(")
+
+# The ways a Python re call can be written with a quoted pattern as its first argument, and re.compile with anything.
+PYTHON_PATTERN_CALL = pattern(word_edge, "re.", any_of("compile(", sequence(any_of("search", "match", "fullmatch", "findall", "finditer", "sub", "split"), "(", optional_spaces, zero_or_more(one_character_from("rRbB")), one_character_from("\"'"))))
+
+# A Piece made from quoted text outside readable_patterns.py.
+PIECE_FROM_TEXT = pattern(word_edge, "Piece(", optional_spaces, one_character_from("\"'"))
+
+# A JavaScript pattern written between slashes, right after an opening bracket, comma or equals.
+JAVASCRIPT_PATTERN = pattern(one_character_from("(,="), optional_spaces, "/", one_character_except("/* \t"), anything_except("/"), "/", zero_or_more(one_character_from("gimsuy")))
+
+# A C# pattern: new Regex(...) always, or a static Regex call that is given quoted text.
+CSHARP_PATTERN_CALL = pattern(any_of(sequence("new", spaces, "Regex", optional_spaces, "("), sequence(word_edge, "Regex.", any_of("Match", "IsMatch", "Matches", "Replace", "Split"), "(", rest_of_line, '"')))
+
+# A private helper's name: an underscore, then a letter. Attribute access (.name) is not one.
+PRIVATE_NAME = pattern(not_preceded_by(any_of(word_character, ".")), "_", letter, word_characters)
+
+# A line that only gives an old private helper a new name: readable_name = _old_name
+ALIAS_LINE = pattern(line_start, optional_spaces, capture(letter, word_characters), optional_spaces, "=", optional_spaces, "_", letter, word_characters, optional_spaces, optional("#", rest_of_line), line_end)
+
+PYTHON_EXTENSIONS = (".py",)
+JAVASCRIPT_EXTENSIONS = (".js", ".mjs", ".ts", ".tsx", ".jsx")
+HTML_EXTENSIONS = (".html", ".htm")
+CSHARP_EXTENSIONS = (".cs",)
+
+
+def text_between(quote):
+    """Quoted text: this quote mark, anything inside (a backslash escapes the next character), this quote mark."""
+    return sequence(quote, zero_or_more(any_of(one_character_except(quote + "\\"), sequence("\\", any_character))), quote)
+
+
+# A quoted piece of text: single quotes or double quotes, or a C# verbatim @"..." string where "" is a quote inside.
+QUOTED_TEXT = any_of(sequence('@"', zero_or_more(any_of(one_character_except('"'), '""')), '"'), text_between("'"), text_between('"'))
+STRING_LITERAL = pattern(QUOTED_TEXT)
+
+# Two blanked quoted texts side by side with only spaces between, as Python joins them silently: "" f""
+SIDE_BY_SIDE_TEXT = pattern('""', spaces, zero_or_more(one_character_from("rRbBfF")), '""')
+
+# Where a triple-quoted string opens: an optional r, b, u or f prefix, then three quotes.
+BLOCK_STRING_START = sequence(zero_or_more(one_character_from("rRbBuUfF")), any_of('"""', "'''"))
+
+# Quoted text, or a triple-quoted string that opens here (blanked to the end of the line). The earliest one on the line wins, so a triple quote inside an ordinary string does not count.
+TEXT_TO_BLANK = pattern(any_of(sequence(BLOCK_STRING_START, rest_of_line), QUOTED_TEXT))
+
+# One Python name, or several separated by commas: "a" or "first, second".
+PYTHON_NAME_LIST = capture(PYTHON_NAME, zero_or_more(optional_spaces, ",", optional_spaces, PYTHON_NAME))
+
+# A Python line that assigns to one or more names: "total = 0" or "first, second = pair".
+PYTHON_ASSIGNMENT = pattern(line_start, optional_spaces, PYTHON_NAME_LIST, optional_spaces, optional(one_character_from("-+*/")), "=", not_followed_by("="))
+
+# A Python function definition: its name, then the text of its parameters.
+PYTHON_FUNCTION = pattern(line_start, optional_spaces, optional("async", spaces), "def", spaces, capture(PYTHON_NAME), optional_spaces, "(", capture(anything_except(")")))
+
+# The names a Python "for ... in" loop creates.
+PYTHON_LOOP_NAMES = pattern(word_edge, "for", spaces, PYTHON_NAME_LIST, spaces, "in", word_edge)
+
+# The name after "as", in "with ... as name" or "except ... as name".
+PYTHON_AS_NAME = pattern(word_edge, "as", spaces, capture(PYTHON_NAME))
+
+# The name a JavaScript const, let or var declares.
+JAVASCRIPT_DECLARATION = pattern(word_edge, any_of("const", "let", "var"), spaces, capture(JAVASCRIPT_NAME))
+
+# A JavaScript function definition: its name, then the text of its parameters.
+JAVASCRIPT_FUNCTION = pattern(word_edge, "function", spaces, capture(JAVASCRIPT_NAME), optional_spaces, "(", capture(anything_except(")")))
+
+# The parameters before an arrow (=>): either "(a, b)" or a single bare name.
+ARROW_PARAMETERS = pattern(any_of(sequence("(", capture(anything_except("()")), ")"), sequence(word_edge, capture(JAVASCRIPT_NAME))), optional_spaces, "=>")
+
+# A named arrow function with a body: "const name = (...) => {".
+JAVASCRIPT_ARROW_FUNCTION = pattern(word_edge, any_of("const", "let"), spaces, JAVASCRIPT_NAME, optional_spaces, "=", optional_spaces, optional("async", optional_spaces), "(", anything_except(")"), ")", optional_spaces, "=>", optional_spaces, "{")
+
+# Words a C# declaration may begin with, before its type.
+CSHARP_MODIFIER = any_of("public", "private", "protected", "internal", "static", "virtual", "override", "abstract", "async", "sealed", "extern", "unsafe", "partial", "readonly", "const")
+
+# A C# type: a built-in one or a capitalised name, then optional <generic arguments>, [] array marks and a ? mark.
+CSHARP_TYPE = sequence(any_of("var", "void", "int", "uint", "long", "ulong", "short", "byte", "float", "double", "decimal", "bool", "char", "string", "object", sequence(capital_letter, word_characters)), optional("<", anything_except("=;(){}"), ">"), zero_or_more("[]"), optional("?"))
+
+# A C# local or field declaration: "var name =", "int name;", "List<int> name =" or "var name in" of a foreach.
+CSHARP_DECLARATION = pattern(word_edge, CSHARP_TYPE, spaces, capture(PYTHON_NAME), optional_spaces, any_of(sequence("=", not_followed_by(one_character_from("=>"))), ";", sequence("in", space)))
+
+# A C# method definition: modifiers, return type, name, then the text of its parameters.
+CSHARP_METHOD = pattern(line_start, optional_spaces, zero_or_more(CSHARP_MODIFIER, spaces), CSHARP_TYPE, spaces, capture(PYTHON_NAME), optional_spaces, "(", capture(anything_except(")")))
+
+# A C# constructor: at least one modifier, the class name, then the text of its parameters.
+CSHARP_CONSTRUCTOR = pattern(line_start, optional_spaces, one_or_more(CSHARP_MODIFIER, spaces), capture(PYTHON_NAME), optional_spaces, "(", capture(anything_except(")")))
+
+# The name at the end of one C# parameter such as "ref Type name".
+CSHARP_PARAMETER_NAME = pattern(space, capture(PYTHON_NAME), line_end)
+
+# A C# attribute line such as [SerializeField].
+CSHARP_ATTRIBUTE_LINE = pattern(line_start, optional_spaces, "[", anything_except("]"), "]", optional_spaces, line_end)
+
+# Any name in a line of code.
+ANY_NAME = pattern(JAVASCRIPT_NAME)
+
+# A parameter that is one plain name.
+PLAIN_PARAMETER = pattern(line_start, JAVASCRIPT_NAME, line_end)
+
+# A condition part that is already a yes-or-no name: "is_ready", "not is_done" or "!isDone".
+PLAIN_NAME = pattern(line_start, optional("("), optional_spaces, optional(any_of(sequence("not", spaces), "!")), JAVASCRIPT_NAME, zero_or_more(".", JAVASCRIPT_NAME), zero_or_more(any_of(space, one_character_from("),;"))), line_end)
+
+# The point between a lower-case letter or digit and the capital that starts the next word.
+CAMEL_CASE_BOUNDARY = pattern(preceded_by(lower_case_letter_or_digit), followed_by(capital_letter))
+
+# Where a condition starts: after if, while, return or a single equals sign.
+CONDITION_START = pattern(any_of(sequence(word_edge, "if", word_edge), sequence(word_edge, "while", word_edge), sequence(word_edge, "return", word_edge), sequence("=", not_followed_by("="))))
+
+# What joins the parts of a condition: and, or in Python; && and || elsewhere.
+PYTHON_JOINER = pattern(any_of(sequence(word_edge, "and", word_edge), sequence(word_edge, "or", word_edge)))
+BRACES_JOINER = pattern(any_of("&&", "||"))
+
+LAMBDA_WORD = pattern(word_edge, "lambda", word_edge)
+LEADING_FOR = pattern(line_start, optional_spaces, "for", word_edge)
+FOR_WORD = pattern(word_edge, "for", word_edge)
+
+# A for loop's header, whose semicolons belong together.
+FOR_HEADER = pattern(word_edge, "for", optional_spaces, "(", anything_except(")"), ")")
+
+# A line that ends with a mark or word which says the statement carries on below.
+CONTINUED_BELOW = pattern(any_of(one_character_from("\\+-*/%.?"), "&&", "||", "=>", sequence(word_edge, any_of("and", "or"))), optional_spaces, line_end)
+
+# A line that starts with a mark or word that carries on the statement above.
+CONTINUES_ABOVE = pattern(line_start, optional_spaces, any_of(one_character_from(".+"), "&&", "||", sequence(any_of("and", "or"), space)))
+
+SCRIPT_OPEN = pattern("<script", word_edge, ignore_case=True)
+SCRIPT_CLOSE = pattern("</script>", ignore_case=True)
+UNESCAPED_BACKTICK = pattern(not_preceded_by("\\"), "`")
+
+
+def words_in_name(name):
+    """The words a name is made of: split on underscores and on camelCase capitals."""
+    words = []
+    for piece in name.strip("_$").split("_"):
+        words.extend(CAMEL_CASE_BOUNDARY.split(piece))
+    return [word.lower() for word in words if word]
+
+
+def name_problem(name):
+    """Why a name makes the reader guess, or "" when it says what it holds."""
+    if name in KNOWN_SHORT_WORDS:
+        return ""
+    words = words_in_name(name)
+    has_several_words = len(words) > 1
+    for word in words:
+        is_known_word = word in KNOWN_SHORT_WORDS or word in KNOWN_ABBREVIATIONS
+        is_connecting_word = has_several_words and word in CONNECTING_WORDS
+        is_number = word.isdigit()
+        if is_known_word or is_connecting_word or is_number:
+            continue
+        if word in GUESSWORK_ABBREVIATIONS:
+            return f'"{word}" is an abbreviation; write the whole word'
+        if len(word) < MIN_WORD_LENGTH:
+            return f'"{word}" is too short to say what it holds'
+    return ""
+
+
+def parameter_names(parameter_text):
+    """The names in a parameter list such as "items, count=0, *rest"."""
+    names = []
+    for parameter in parameter_text.split(","):
+        bare = parameter.split("=")[0].split(":")[0].strip().lstrip("*").strip()
+        if PLAIN_PARAMETER.match(bare):
+            names.append(bare)
+    return names
+
+
+def csharp_parameter_names(parameter_text):
+    """The names in a C# parameter list such as "int count, ref Vector3 where, string label = x"."""
+    names = []
+    for parameter in parameter_text.split(","):
+        bare = parameter.split("=")[0].strip()
+        found = CSHARP_PARAMETER_NAME.search(bare)
+        if found:
+            names.append(found.group(1))
+    return names
+
+
+def blank_text(match):
+    """What replaces a quoted string: an empty pair of quotes."""
+    return '""'
+
+
+def without_strings(line):
+    """The line with the inside of every quoted string blanked, so code rules never read text. A triple-quoted string that opens on this line is blanked to the end of the line."""
+    return TEXT_TO_BLANK.sub(blank_text, line)
+
+
+def names_bound_in_python(code):
+    """Every name a Python line creates: assignments, functions, parameters, loops and "as"."""
+    names = []
+    assignment = PYTHON_ASSIGNMENT.match(code)
+    if assignment:
+        names.extend(part.strip() for part in assignment.group(1).split(","))
+    function = PYTHON_FUNCTION.match(code)
+    if function:
+        names.append(function.group(1))
+        names.extend(parameter_names(function.group(2)))
+    for loop in PYTHON_LOOP_NAMES.finditer(code):
+        names.extend(part.strip() for part in loop.group(1).split(","))
+    names.extend(PYTHON_AS_NAME.findall(code))
+    return names
+
+
+def arrow_parameter_names(code):
+    """The parameter names of every arrow function (=>) on a JavaScript or C# line."""
+    names = []
+    for arrow in ARROW_PARAMETERS.finditer(code):
+        bracketed_parameters, single_parameter = arrow.groups()
+        if bracketed_parameters is not None:
+            names.extend(parameter_names(bracketed_parameters))
+        elif single_parameter:
+            names.append(single_parameter)
+    return names
+
+
+def names_bound_in_javascript(code):
+    """Every name a JavaScript line creates: declarations, functions and arrow parameters."""
+    names = list(JAVASCRIPT_DECLARATION.findall(code))
+    for function in JAVASCRIPT_FUNCTION.finditer(code):
+        names.append(function.group(1))
+        names.extend(parameter_names(function.group(2)))
+    names.extend(arrow_parameter_names(code))
+    return names
+
+
+def names_bound_in_csharp(code):
+    """Every name a C# line creates: declarations, methods, constructors, their parameters and lambda parameters."""
+    names = list(CSHARP_DECLARATION.findall(code))
+    for definition in (CSHARP_METHOD.match(code), CSHARP_CONSTRUCTOR.match(code)):
+        if definition:
+            names.append(definition.group(1))
+            names.extend(csharp_parameter_names(definition.group(2)))
+    names.extend(arrow_parameter_names(code))
+    return names
+
+
+def has_unnamed_condition(code, joiner):
+    """True when a condition joins three or more parts and one is not a plain yes-or-no name."""
+    condition = CONDITION_START.split(code)[-1].rstrip(":{ ")
+    parts = joiner.split(condition)
+    if len(parts) < 3:
+        return False
+    return not all(PLAIN_NAME.match(part.strip()) for part in parts)
+
+
+def older_helper_problems(code, existing_names):
+    """Rule 1 for an older private helper that new code calls: it needs a readable name too. A helper the same change also removes or already used is left to the clean-up issue, and a line that only gives an old helper a readable name (run_git_in = _mp_git) is the fix itself."""
+    alias = ALIAS_LINE.match(code)
+    if alias and not name_problem(alias.group(1)):
+        return []
+    problems = []
+    for helper_name in sorted(set(PRIVATE_NAME.findall(code))):
+        if helper_name in existing_names:
+            continue
+        why = name_problem(helper_name)
+        if why:
+            problems.append(f"rule 1, whole-word names: the older helper {helper_name}: {why}; give it a readable name where new code calls it")
+    return problems
+
+
+def name_problems(names, existing_names):
+    """Rule 1 for the names a line creates, leaving out names that were already in the file."""
+    problems = []
+    for name in names:
+        if name in existing_names:
+            continue
+        why = name_problem(name)
+        if why:
+            problems.append(f"rule 1, whole-word names: {why}")
+    return problems
+
+
+def text_problems(line, language):
+    """Rule 7 for one line, read with its quoted text still in place."""
+    for quoted in STRING_LITERAL.findall(line):
+        text_before = line[:line.find(quoted)].rstrip()
+        if language == "csharp":
+            is_interpolated = text_before.endswith(("$", "$@", "@$"))
+            if COMPOSITE_PLACEHOLDER.search(quoted) and not is_interpolated:
+                return [VALUES_IN_PLACE_CSHARP]
+            continue
+        is_format_string = text_before.endswith(("f", "rf", "fr"))
+        if PERCENT_PLACEHOLDER.search(quoted) and not is_format_string:
+            return [VALUES_IN_PLACE]
+    return []
+
+
+def opens_more_than_closes(code, opening, closing):
+    """True when the line opens more of this bracket than it closes."""
+    return code.count(opening) > code.count(closing)
+
+
+def split_statement_problems(code):
+    """Rule 4: a statement is never split across lines. A list, dict or block bracket that is the last thing on its line is allowed."""
+    if CONTINUED_BELOW.search(code) or CONTINUES_ABOVE.match(code):
+        return [KEEP_ON_ONE_LINE]
+    if opens_more_than_closes(code, "(", ")"):
+        return [KEEP_ON_ONE_LINE]
+    for opening, closing in (("[", "]"), ("{", "}")):
+        ends_with_opening = code.rstrip().endswith(opening)
+        if opens_more_than_closes(code, opening, closing) and not ends_with_opening:
+            return [KEEP_ON_ONE_LINE]
+    return []
+
+
+def python_problems(code, existing_names):
+    """Rules 1, 2, 3 and 6 for one line of Python with its strings blanked. Names in existing_names were already in the file, so rule 1 leaves them to the clean-up issue."""
+    problems = name_problems(names_bound_in_python(code), existing_names)
+    problems.extend(older_helper_problems(code, existing_names))
+    if PERCENT_OPERATOR.search(code):
+        problems.append(VALUES_IN_PLACE)
+    if SIDE_BY_SIDE_TEXT.search(code):
+        problems.append(JOIN_THE_TEXT)
+    if ";" in code:
+        problems.append(SPLIT_STATEMENTS)
+    if has_unnamed_condition(code, PYTHON_JOINER):
+        problems.append(NAME_THE_CONDITION)
+    if LAMBDA_WORD.search(code):
+        problems.append(NO_LAMBDA)
+    # A leading "for" starts a loop statement, so only the fors after it are comprehensions.
+    expression = LEADING_FOR.sub("", code)
+    if len(FOR_WORD.findall(expression)) >= 2:
+        problems.append(NO_NESTED_LOOPS)
+    return problems
+
+
+def braces_problems(code, existing_names, bound_names):
+    """Rules 1, 2, 3 and 6 for one line of JavaScript or C# with its strings blanked."""
+    problems = name_problems(bound_names, existing_names)
+    problems.extend(older_helper_problems(code, existing_names))
+    statement_part = FOR_HEADER.sub("for ()", code).rstrip()
+    if ";" in statement_part.rstrip(";"):
+        problems.append(SPLIT_STATEMENTS)
+    if has_unnamed_condition(code, BRACES_JOINER):
+        problems.append(NAME_THE_CONDITION)
+    if "=>" in code:
+        arrow_body = code.split("=>", 1)[1]
+        has_choice = "?" in arrow_body and ":" in arrow_body
+        has_condition = "&&" in arrow_body or "||" in arrow_body
+        has_nested_arrow = "=>" in arrow_body
+        if has_choice or has_condition or has_nested_arrow:
+            problems.append(NAME_THE_ARROW)
+    return problems
+
+
+def javascript_problems(code, existing_names):
+    """Rules 1, 2, 3 and 6 for one line of JavaScript with its strings blanked."""
+    return braces_problems(code, existing_names, names_bound_in_javascript(code))
+
+
+def csharp_problems(code, existing_names):
+    """Rules 1, 2, 3 and 6 for one line of C# with its strings blanked, and the string.Format part of rule 7."""
+    problems = braces_problems(code, existing_names, names_bound_in_csharp(code))
+    if CSHARP_FORMAT_CALL.search(code):
+        problems.append(VALUES_IN_PLACE_CSHARP)
+    return problems
+
+
+def language_of(file_name):
+    """ "python", "javascript", "csharp", "html" or "" for a file the code rules do not read."""
+    if file_name.endswith(PYTHON_EXTENSIONS):
+        return "python"
+    if file_name.endswith(JAVASCRIPT_EXTENSIONS):
+        return "javascript"
+    if file_name.endswith(CSHARP_EXTENSIONS):
+        return "csharp"
+    if file_name.endswith(HTML_EXTENSIONS):
+        return "html"
+    return ""
+
+
+TRIPLE_QUOTES = ('"""', "'''")
+
+
+def python_block_quote_after(line, open_block_quote):
+    """Which triple quote is still open after this line ("" for none). Reads the line one character at a time, so a triple quote written inside an ordinary string does not count."""
+    position = 0
+    open_single_quote = ""
+    while position < len(line):
+        character = line[position]
+        three_characters = line[position:position + 3]
+        if open_block_quote:
+            if three_characters == open_block_quote:
+                open_block_quote = ""
+                position += 3
+                continue
+            position += 2 if character == "\\" else 1
+            continue
+        if open_single_quote:
+            if character == "\\":
+                position += 2
+                continue
+            if character == open_single_quote:
+                open_single_quote = ""
+            position += 1
+            continue
+        if character == "#":
+            break
+        if three_characters in TRIPLE_QUOTES:
+            open_block_quote = three_characters
+            position += 3
+            continue
+        if character in ("'", '"'):
+            open_single_quote = character
+        position += 1
+    return open_block_quote
+
+
+class LineState:
+    """Where a line sits in its file: inside a multi-line string, and, in HTML, inside a script."""
+
+    def __init__(self):
+        """Start outside every string and script, as at the top of a file."""
+        self.in_python_block_string = False
+        self.python_block_quote = ""
+        self.in_javascript_template = False
+        self.in_html_script = False
+
+    def is_code(self, language):
+        """True when the next line is code the rules read, not text in a string or HTML."""
+        if language == "python":
+            return not self.in_python_block_string
+        if language == "javascript":
+            return not self.in_javascript_template
+        if language == "csharp":
+            return True
+        if language == "html":
+            return self.in_html_script and not self.in_javascript_template
+        return False
+
+    def move_past(self, line, language):
+        """Update the state for what this line opens or closes."""
+        if language == "python":
+            self.python_block_quote = python_block_quote_after(line, self.python_block_quote)
+            self.in_python_block_string = bool(self.python_block_quote)
+            return
+        if language == "csharp":
+            return
+        if language == "html":
+            if SCRIPT_OPEN.search(line):
+                self.in_html_script = True
+            if SCRIPT_CLOSE.search(line):
+                self.in_html_script = False
+        backticks = len(UNESCAPED_BACKTICK.findall(line))
+        if backticks % 2 == 1:
+            self.in_javascript_template = not self.in_javascript_template
+
+
+def state_before_line(original_lines, line_number, language):
+    """The LineState at a line of the original file, found by reading every line above it."""
+    state = LineState()
+    for line in original_lines[:max(0, line_number - 1)]:
+        state.move_past(line, language)
+    return state
+
+
+def read_original_file(project, file_name):
+    """The file's lines before the diff, or [] when it is new or can't be read."""
+    try:
+        with open(os.path.join(project, file_name), encoding="utf-8") as original:
+            return original.read().splitlines()
+    except (OSError, UnicodeDecodeError):
+        return []
+
+
+def comment_above_csharp_method(lines_above):
+    """True when a C# method has a comment directly above it, or above the attribute lines such as [SerializeField] that sit directly above it."""
+    for line in reversed(lines_above):
+        if CSHARP_ATTRIBUTE_LINE.match(line):
+            continue
+        return line.strip().startswith(("//", "/*", "*"))
+    return False
+
+
+def function_description_problem(added_line, next_lines, lines_above, language):
+    """Rule 5: why a new function has no plain description, or ""."""
+    previous_line = lines_above[-1] if lines_above else ""
+    if language == "csharp":
+        is_method = bool(CSHARP_METHOD.match(added_line) or CSHARP_CONSTRUCTOR.match(added_line))
+        if is_method and not comment_above_csharp_method(lines_above):
+            return DESCRIBE_THE_FUNCTION
+        return ""
+    is_python_function = language == "python" and PYTHON_FUNCTION.match(added_line)
+    is_javascript_language = language in ("javascript", "html")
+    has_javascript_function = bool(JAVASCRIPT_FUNCTION.search(added_line) or JAVASCRIPT_ARROW_FUNCTION.search(added_line))
+    is_javascript_function = is_javascript_language and has_javascript_function
+    if not (is_python_function or is_javascript_function):
+        return ""
+    previous_is_comment = previous_line.strip().startswith(("#", "//", "/*", "*"))
+    if previous_is_comment:
+        return ""
+    if is_python_function:
+        body_lines = [line.strip() for line in next_lines if line.strip()]
+        first_body_line = body_lines[0] if body_lines else ""
+        if first_body_line.startswith(('"""', "'''", "#")):
+            return ""
+    return DESCRIBE_THE_FUNCTION
+
+
+def names_in_removed_lines(lines):
+    """Every name the hunk's removed lines bind: names that existed before this change."""
+    names = set()
+    for kind, text in lines:
+        if kind != "-":
+            continue
+        code = without_strings(text)
+        names.update(ANY_NAME.findall(code))
+    return names
+
+
+def without_comment(code, language):
+    """The code part of a line whose quoted text is blanked: a comment is prose, not code."""
+    if language == "python":
+        return code.split("#", 1)[0]
+    if code.lstrip().startswith(("/*", "*")):
+        return ""
+    return code.split("//", 1)[0]
+
+
+def raw_pattern_problem(code, language, file_name):
+    """Rule 8: why this line writes raw pattern text instead of building it from named pieces, or ""."""
+    if os.path.basename(file_name) == PATTERN_BUILDER_FILE:
+        return ""
+    if language == "python":
+        writes_pattern = PYTHON_PATTERN_CALL.search(code) or PIECE_FROM_TEXT.search(code)
+        return USE_NAMED_PIECES if writes_pattern else ""
+    if language == "csharp":
+        return NO_CSHARP_BUILDER if CSHARP_PATTERN_CALL.search(code) else ""
+    return USE_NAMED_PIECES if JAVASCRIPT_PATTERN.search(code) else ""
+
+
+def code_problems(text, language, file_name, existing_names, next_lines, lines_above):
+    """Every rule broken by one added line of code."""
+    code = without_comment(without_strings(text), language)
+    if language == "python":
+        problems = python_problems(code, existing_names)
+    elif language == "csharp":
+        problems = csharp_problems(code, existing_names)
+    else:
+        problems = javascript_problems(code, existing_names)
+    problems.extend(split_statement_problems(code))
+    description = function_description_problem(text, next_lines, lines_above, language)
+    if description:
+        problems.append(description)
+    if language in ("python", "csharp"):
+        problems.extend(text_problems(text, language))
+    pattern_problem = raw_pattern_problem(code, language, file_name)
+    if pattern_problem:
+        problems.append(pattern_problem)
+    return problems
+
+
+def problems_in_file(file_name, hunks, project, read_file=None):
+    """Every rule broken by the lines this file's hunks add, as "file:line: problem" strings."""
+    language = language_of(file_name)
+    original_lines = read_original_file(project, file_name) if read_file is None else read_file(file_name)
+    problems = []
+    for old_start, new_start, lines in hunks:
+        state = state_before_line(original_lines, old_start, language)
+        new_line_number = new_start
+        new_side = [(kind, text) for kind, text in lines if kind != "-"]
+        existing_names = names_in_removed_lines(lines)
+        for position, (kind, text) in enumerate(new_side):
+            if kind == "+" and state.is_code(language):
+                lines_above = [line for _, line in new_side[:position]]
+                next_lines = [line for _, line in new_side[position + 1:position + 4]]
+                found = code_problems(text, language, file_name, existing_names, next_lines, lines_above)
+                problems.extend(f"{file_name}:{new_line_number}: {problem}" for problem in found)
+            state.move_past(text, language)
+            new_line_number += 1
+    return problems
+
+
+def hunks_by_file(diff_text):
+    """{file: [(old start, new start, [(kind, text), ...]), ...]} from a unified diff."""
+    files = {}
+    current_file = None
+    for line in diff_text.splitlines():
+        if line.startswith(FILE_START_MARKER):
+            current_file = line.split(NEW_PATH_MARKER, 1)[-1]
+            files[current_file] = []
+            continue
+        header = HUNK_HEADER.match(line)
+        if header and current_file is not None:
+            files[current_file].append((int(header.group(1)), int(header.group(2)), []))
+            continue
+        is_file_header = line.startswith((OLD_FILE_MARKER, NEW_FILE_MARKER, "index ", "new file", "deleted file"))
+        is_before_first_hunk = current_file is None or not files[current_file]
+        if is_before_first_hunk or is_file_header:
+            continue
+        kind = line[:1] if line[:1] in ("+", "-", " ") else " "
+        files[current_file][-1][2].append((kind, line[1:]))
+    return files
+
+
+def find_problems(diff_text, project, read_file=None):
+    """Every readability problem in the lines a unified diff adds, in file order."""
+    problems = []
+    for file_name, hunks in hunks_by_file(diff_text).items():
+        problems.extend(problems_in_file(file_name, hunks, project, read_file))
+    return problems
+
+
+def main(arguments):
+    """Command line: check one draft and print each problem."""
+    if len(arguments) < 2 or arguments[0] != "check":
+        print(__doc__.strip().splitlines()[2].strip())
+        return 2
+    project = os.getcwd()
+    if "--project" in arguments:
+        project = arguments[arguments.index("--project") + 1]
+    try:
+        with open(arguments[1], encoding="utf-8") as draft:
+            diff_text = draft.read()
+    except OSError as error:
+        print(f"readability: could not read {arguments[1]}: {error}")
+        return 2
+    problems = find_problems(diff_text, project)
+    for problem in problems:
+        print(problem)
+    if problems:
+        print(f"readability: {len(problems)} problem(s) in {arguments[1]}")
+        return 1
+    print(f"readability: every added line in {arguments[1]} is readable")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv[1:]))
