+# aj's message "Not part of <feature>: #N #M": captures the feature name, then the issue numbers.
+NOT_PART_OF_MESSAGE = re.compile(r"\bnot part of\s+([^:\n]+):\s*((?:#\d+[\s,]*(?:and\s+)?)+)",
+                                 re.IGNORECASE)
+
+
+def remove_issues_not_part_of(state, text):
+    """#475: aj's "Not part of <feature>: #N #M" takes those issues out of the current feature's
+    record, so their labels are no longer checked. Returns a note, or "" when there is none."""
+    message = NOT_PART_OF_MESSAGE.search(text)
+    if not message:
+        return ""
+    named_feature = _loop_name(message.group(1))
+    current_feature = state.get("feature") or ""
+    if named_feature.lower() != current_feature.lower():
+        current_name = current_feature or "(none)"
+        return (f'Design loop: aj wrote "Not part of {named_feature}", but the current feature is '
+                f'"{current_name}", so no issue was taken out.')
+    # Each issue number written as #N, such as #475.
+    named_numbers = [int(number) for number in re.findall(r"#(\d+)", message.group(2))]
+    kept_issues = []
+    removed_numbers = []
+    for issue in state.get("issues", []):
+        if isinstance(issue, dict) and issue.get("number") in named_numbers:
+            removed_numbers.append(issue["number"])
+        else:
+            kept_issues.append(issue)
+    state["issues"] = kept_issues
+    if not removed_numbers:
+        named_text = ", ".join(f"#{number}" for number in named_numbers)
+        return (f'Design loop: aj wrote "Not part of {current_feature}", but none of {named_text} '
+                "is in its record.")
+    removed_text = ", ".join(f"#{number}" for number in removed_numbers)
+    return (f'Design loop: aj took {removed_text} out of "{current_feature}"; they no longer count '
+            "toward it or need its labels.")
+
+
 def _loop_apply(state, text, top):
