+            removed_numbers.append(issue["number"])
+        else:
+            kept_issues.append(issue)
+    state["issues"] = kept_issues
+    if not removed_numbers:
+        return ('Design loop: aj wrote "Not part of %s", but none of %s is in its record.'
+                % (current_feature, ", ".join("#%d" % number for number in named_numbers)))
+    removed_text = ", ".join("#%d" % number for number in removed_numbers)
